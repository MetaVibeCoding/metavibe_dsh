# cordis.yml.example — mounting metavibe-dsh into a DeepSeek Harness agent preset
#
# Copy this row into an agent preset's `agent.cordis.yml` (under a `plugins:`
# list) after the package is installed in the deployment's node_modules.
#
# metavibe-dsh publishes no service and needs no config — it only registers
# the three READ-ONLY knowledge tools (`metavibe_hub_list`,
# `metavibe_catalog_tree`, `metavibe_catalog_inspect`), consumes only the
# `tools` registry, and never touches the workspace. It sits loose in the
# preset and needs no `isolate` realm.
#
#   plugins:
#     - id: tool-metavibe
#       name: metavibe-dsh

- id: tool-metavibe
  name: metavibe-dsh
